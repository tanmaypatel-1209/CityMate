<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account</title>
  <!-- Modern Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #ffffff;
      --card-bg: #ffffff;
      --border-color: #e2e8f0;
      --border-focus: #000000;
      --text-primary: #0f172a;
      --text-secondary: #64748b;
      --input-bg: #f8fafc;
      --accent: #000000;
      --accent-hover: #1e293b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow-y: auto;
      position: relative;
      padding: 2rem 1.25rem;
      background-image: 
        radial-gradient(circle at 10% 20%, rgba(0, 0, 0, 0.03) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(0, 0, 0, 0.03) 0%, transparent 40%);
    }

    /* Subtle background grid pattern */
    body::before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
      background-size: 32px 32px;
      background-position: center;
      z-index: 1;
      pointer-events: none;
    }

    .card {
      position: relative;
      z-index: 10;
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 2.25rem;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-2px);
      box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.12);
    }

    .header {
      margin-bottom: 1.5rem;
      text-align: center;
    }

    .logo {
      width: 42px;
      height: 42px;
      background: #000000;
      color: #ffffff;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.85rem auto;
      font-weight: 800;
      font-size: 1.25rem;
    }

    .title {
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      margin-bottom: 0.35rem;
      color: var(--text-primary);
    }

    .subtitle {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .form-group {
      margin-bottom: 1rem;
      position: relative;
    }

    .form-group label {
      display: block;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.4rem;
      color: var(--text-secondary);
      transition: color 0.2s ease;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      background-color: var(--input-bg);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 0.8rem 0.95rem;
      color: var(--text-primary);
      font-size: 0.925rem;
      outline: none;
      transition: all 0.2s ease;
      appearance: none;
    }

    .form-group select option {
      background-color: #ffffff;
      color: var(--text-primary);
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--border-focus);
      background-color: #ffffff;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
    }

    .location-status {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .location-status .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #f59e0b;
      display: inline-block;
    }

    .location-status.success .dot {
      background-color: #10b981;
    }

    .location-status.error .dot {
      background-color: #ef4444;
    }

    .location-status .status-text {
      font-weight: 500;
    }

    .select-wrapper {
      position: relative;
    }

    .select-wrapper::after {
      content: "▼";
      font-size: 0.65rem;
      position: absolute;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-secondary);
      pointer-events: none;
    }

    .btn-submit {
      width: 100%;
      background-color: var(--accent);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 0.85rem;
      font-size: 0.925rem;
      font-weight: 700;
      cursor: pointer;
      margin-top: 0.85rem;
      transition: all 0.2s ease;
    }

    .btn-submit:hover {
      background-color: var(--accent-hover);
      transform: translateY(-1px);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    .footer-text {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .footer-link {
      color: var(--text-primary);
      text-decoration: none;
      font-weight: 700;
      border-bottom: 1.5px solid #000000;
    }

    .footer-link:hover {
      opacity: 0.7;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">
      <div class="logo">⚡</div>
      <h1 class="title">Create Account</h1>
      <p class="subtitle">Enter your details to sign up</p>
    </div>

    <form action="/signup" method="POST">
      <div class="form-group">
        <label for="username">Username</label>
        <input 
          type="text" 
          id="username" 
          name="username" 
          placeholder="e.g. johndoe" 
          required 
          autocomplete="username"
        />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          placeholder="name@example.com" 
          required 
          autocomplete="email"
        />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input 
          type="password" 
          id="password" 
          name="password" 
          placeholder="••••••••" 
          required 
          autocomplete="new-password"
        />
      </div>

      <div class="form-group">
        <label for="role">Account Type</label>
        <div class="select-wrapper">
          <select id="role" name="role" required>
            <option value="User">User</option>
            <option value="BusinessOwner">Business Owner</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input 
          type="text" 
          id="location" 
          name="location" 
          placeholder="Detecting location..." 
          required 
        />
        <input type="hidden" id="ip" name="ip" />
        <div class="location-status" id="location-status-container">
          <span class="dot" id="location-status-dot"></span>
          <span class="status-text" id="location-status-text">Detecting your location...</span>
        </div>
      </div>

      <button type="submit" class="btn-submit">Sign Up</button>
    </form>

    <div class="footer-text">
      Already have an account? <a href="/login" class="footer-link">Log in</a>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const locationInput = document.getElementById("location");
      const ipInput = document.getElementById("ip");
      const statusDot = document.getElementById("location-status-dot");
      const statusText = document.getElementById("location-status-text");
      const statusContainer = document.getElementById("location-status-container");

      function updateStatus(success, message, ip) {
        if (success) {
          statusContainer.className = "location-status success";
          statusText.textContent = message;
          if (ip) ipInput.value = ip;
        } else {
          statusContainer.className = "location-status error";
          statusText.textContent = message;
        }
      }

      function reverseGeocode(lat, lon, ipAddress) {
        fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=en`)
          .then(res => {
            if (!res.ok) throw new Error("Reverse geocoding failed");
            return res.json();
          })
          .then(data => {
            const parts = [];
            if (data.city) parts.push(data.city);
            if (data.principalSubdivision) parts.push(data.principalSubdivision);
            if (data.countryName) parts.push(data.countryName);
            const loc = parts.join(", ") || "Unknown Location";
            locationInput.value = loc;
            updateStatus(true, `Accurate location detected (IP: ${ipAddress || 'Checked'})`, ipAddress);
          })
          .catch(err => {
            console.error("Reverse geocoding failed:", err);
            fallbackToIpGeocode();
          });
      }

      function fallbackToIpGeocode() {
        // Try ipapi.co
        fetch("https://ipapi.co/json/")
          .then(res => {
            if (!res.ok) throw new Error("ipapi.co failed");
            return res.json();
          })
          .then(data => {
            const parts = [];
            if (data.city) parts.push(data.city);
            if (data.region) parts.push(data.region);
            if (data.country_name) parts.push(data.country_name);
            const loc = parts.join(", ") || "Unknown Location";
            locationInput.value = loc;
            updateStatus(true, `IP-detected location (IP: ${data.ip})`, data.ip);
          })
          .catch(err => {
            console.warn(err);
            // Fallback to geolocation-db.com
            fetch("https://geolocation-db.com/json/")
              .then(res => {
                if (!res.ok) throw new Error("geolocation-db.com failed");
                return res.json();
              })
              .then(data => {
                const parts = [];
                if (data.city) parts.push(data.city);
                if (data.state) parts.push(data.state);
                if (data.country_name) parts.push(data.country_name);
                const loc = parts.join(", ") || "Unknown Location";
                locationInput.value = loc;
                updateStatus(true, `IP-detected location (IP: ${data.IPv4})`, data.IPv4);
              })
              .catch(err2 => {
                console.error("All geoip lookups failed:", err2);
                locationInput.value = "";
                locationInput.placeholder = "Enter your location manually";
                updateStatus(false, "Unable to auto-detect location. Please enter manually.");
              });
          });
      }

      // First fetch IP details (so we have the IP address to store)
      fetch("https://ipapi.co/json/")
        .then(res => {
          if (!res.ok) throw new Error("Could not fetch IP initially");
          return res.json();
        })
        .then(ipData => {
          const ipAddress = ipData.ip;
          if (ipAddress) ipInput.value = ipAddress;

          // Request high accuracy GPS-based location
          if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
              (position) => {
                reverseGeocode(position.coords.latitude, position.coords.longitude, ipAddress);
              },
              (error) => {
                console.warn("Browser Geolocation declined or failed. Using IP fallback.", error);
                const parts = [];
                if (ipData.city) parts.push(ipData.city);
                if (ipData.region) parts.push(ipData.region);
                if (ipData.country_name) parts.push(ipData.country_name);
                const loc = parts.join(", ") || "Unknown Location";
                locationInput.value = loc;
                updateStatus(true, `IP-detected location (IP: ${ipAddress})`, ipAddress);
              },
              { timeout: 5000, enableHighAccuracy: true }
            );
          } else {
            const parts = [];
            if (ipData.city) parts.push(ipData.city);
            if (ipData.region) parts.push(ipData.region);
            if (ipData.country_name) parts.push(ipData.country_name);
            const loc = parts.join(", ") || "Unknown Location";
            locationInput.value = loc;
            updateStatus(true, `IP-detected location (IP: ${ipAddress})`, ipAddress);
          }
        })
        .catch(err => {
          console.warn("Could not load initial IP, attempting browser geolocation fallback...", err);
          if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
              (position) => {
                reverseGeocode(position.coords.latitude, position.coords.longitude, "");
              },
              () => {
                fallbackToIpGeocode();
              },
              { timeout: 5000, enableHighAccuracy: true }
            );
          } else {
            fallbackToIpGeocode();
          }
        });
    });
  </script>

</body>
</html>
