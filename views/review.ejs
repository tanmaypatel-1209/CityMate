<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Review Service - CityMate</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --bg-color: #ffffff;
      --card-bg: #ffffff;
      --card-inner: #f8fafc;
      --border-color: #e2e8f0;
      --border-focus: #000000;
      --text-primary: #0f172a;
      --text-secondary: #64748b;
      --accent: #000000;
      --accent-blue: #2563eb;
      --accent-emerald: #059669;
      --accent-amber: #f59e0b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    
    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg-color);
      color: var(--text-primary);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 2.5rem 1rem;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(0, 0, 0, 0.02) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(0, 0, 0, 0.02) 0%, transparent 40%);
    }

    .container {
      width: 100%;
      max-width: 680px;
    }

    .review-card {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 2.25rem;
      box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.08);
      margin-bottom: 2rem;
    }

    .title {
      font-size: 1.75rem;
      font-weight: 800;
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      letter-spacing: -0.02em;
      color: var(--text-primary);
    }

    .subtitle {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.6;
      font-size: 0.95rem;
    }

    .service-id-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      color: #0f172a;
      font-size: 0.85rem;
      font-weight: 700;
      word-break: break-all;
    }

    form { display: flex; flex-direction: column; gap: 1.35rem; }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    label { font-weight: 700; color: var(--text-primary); font-size: 0.9rem; }

    /* Interactive Star Picker */
    .star-picker-container {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--card-inner);
      padding: 0.85rem 1.1rem;
      border-radius: 14px;
      border: 1px solid var(--border-color);
    }

    .star-picker {
      display: flex;
      gap: 0.4rem;
      cursor: pointer;
    }

    .star-picker span {
      font-size: 1.75rem;
      color: #cbd5e1;
      transition: transform 0.15s ease, color 0.15s ease;
      user-select: none;
    }

    .star-picker span:hover,
    .star-picker span.active {
      color: #f59e0b;
      transform: scale(1.15);
    }

    .rating-label-text {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-secondary);
      margin-left: 0.5rem;
    }

    textarea, select {
      width: 100%;
      padding: 0.9rem 1.1rem;
      border-radius: 14px;
      border: 1px solid var(--border-color);
      background: var(--card-inner);
      color: var(--text-primary);
      outline: none;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }

    textarea:focus, select:focus {
      border-color: var(--border-focus);
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
    }

    textarea { min-height: 125px; resize: vertical; line-height: 1.5; }

    .actions {
      display: flex;
      gap: 0.85rem;
      margin-top: 0.5rem;
    }

    button, a.btn-secondary {
      border: none;
      border-radius: 14px;
      padding: 0.9rem 1.35rem;
      font-weight: 700;
      cursor: pointer;
      font-size: 0.925rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-primary {
      background: #000000;
      color: #ffffff;
      flex: 1;
    }

    .btn-primary:hover {
      background: #1e293b;
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #f1f5f9;
      color: var(--text-primary);
      border: 1px solid #cbd5e1;
    }

    .btn-secondary:hover {
      background: #e2e8f0;
      transform: translateY(-1px);
    }

    .toast {
      padding: 0.9rem 1.1rem;
      border-radius: 14px;
      margin-bottom: 1.25rem;
      display: none;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .toast.success {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #059669;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    /* Existing Reviews Section */
    .reviews-section {
      width: 100%;
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 2.25rem;
      box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.08);
    }

    .reviews-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.35rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-color);
    }

    .reviews-header h3 {
      font-size: 1.3rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      letter-spacing: -0.01em;
      color: var(--text-primary);
    }

    .reviews-count-badge {
      background: #f1f5f9;
      border: 1px solid var(--border-color);
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      font-size: 0.825rem;
      color: var(--text-secondary);
      font-weight: 600;
    }

    .reviews-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .review-item {
      background: var(--card-inner);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 1.25rem;
      transition: border-color 0.2s ease;
    }

    .review-item:hover {
      border-color: rgba(255, 255, 255, 0.15);
    }

    .review-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.6rem;
    }

    .stars-row {
      color: var(--accent-amber);
      font-size: 1.1rem;
      letter-spacing: 2px;
    }

    .review-date {
      font-size: 0.8rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    .review-text {
      font-size: 0.94rem;
      color: var(--text-primary);
      line-height: 1.55;
    }

    .empty-reviews {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--text-secondary);
      font-size: 0.925rem;
    }

    .empty-reviews i {
      width: 40px;
      height: 40px;
      color: var(--text-secondary);
      margin-bottom: 0.75rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Submit Review Form Card -->
    <div class="review-card" id="add-review-card">
      <h2 class="title"><i data-lucide="message-square-plus" style="color: #38bdf8;"></i> Leave a Review</h2>
      <p class="subtitle">Share your experience to help others in your city find the best services.</p>
      
      <div class="service-id-badge" id="service-id">
        <i data-lucide="hash"></i> Service ID: <span id="service-id-value">Loading...</span>
      </div>

      <div class="toast success" id="success-toast">
        <i data-lucide="check-circle-2"></i> Review submitted successfully!
      </div>

      <form id="review-form">
        <div class="form-group">
          <label>Your Rating</label>
          <div class="star-picker-container">
            <div class="star-picker" id="star-picker">
              <span data-star="1">★</span>
              <span data-star="2">★</span>
              <span data-star="3">★</span>
              <span data-star="4">★</span>
              <span data-star="5">★</span>
            </div>
            <span class="rating-label-text" id="rating-text">Select rating (1 - 5)</span>
          </div>
          <input type="hidden" id="rating" name="rating" value="5" required />
        </div>

        <div class="form-group">
          <label for="Coment">Your Experience & Feedback</label>
          <textarea id="Coment" name="Coment" placeholder="Write detailed feedback about service quality, timing, staff behavior, pricing..." required></textarea>
        </div>

        <div class="actions">
          <a class="btn-secondary" href="/userdashboard">
            <i data-lucide="arrow-left"></i> Back to Dashboard
          </a>
          <button class="btn-primary" type="submit" id="submit-btn">
            <i data-lucide="send"></i> Submit Review
          </button>
        </div>
      </form>
    </div>

    <!-- Display Customer Reviews Section -->
    <div class="reviews-section">
      <div class="reviews-header">
        <h3><i data-lucide="star" style="color:#f59e0b;"></i> Customer Reviews</h3>
        <div style="display: flex; align-items: center; gap: 0.6rem;">
          <span class="reviews-count-badge" id="reviews-count">0 reviews</span>
          <button id="toggle-add-form-btn" type="button" style="padding: 0.45rem 0.85rem; font-size: 0.8rem; display: none;" class="btn-primary" onclick="toggleReviewForm()">
            <i data-lucide="plus-circle"></i> Write Review
          </button>
        </div>
      </div>

      <div class="reviews-list" id="reviews-list">
        <div class="empty-reviews">
          <i data-lucide="loader"></i>
          <p>Loading reviews...</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      const serviceId = pathParts[pathParts.length - 1];
      const serviceIdValue = document.getElementById('service-id-value');
      const reviewForm = document.getElementById('review-form');
      const reviewsList = document.getElementById('reviews-list');
      const reviewsCount = document.getElementById('reviews-count');
      const successToast = document.getElementById('success-toast');

      const ratingInput = document.getElementById('rating');
      const ratingText = document.getElementById('rating-text');
      const starPickerSpans = document.querySelectorAll('#star-picker span');

      const ratingLabels = {
        1: "⭐ 1 - Poor",
        2: "⭐⭐ 2 - Fair",
        3: "⭐⭐⭐ 3 - Good",
        4: "⭐⭐⭐⭐ 4 - Very Good",
        5: "⭐⭐⭐⭐⭐ 5 - Excellent"
      };

      if (serviceIdValue) {
        serviceIdValue.textContent = serviceId || 'Unknown Service';
      }

      // Check mode=view parameter to hide form when viewing only
      const urlParams = new URLSearchParams(window.location.search);
      const addReviewCard = document.getElementById('add-review-card');
      const toggleAddFormBtn = document.getElementById('toggle-add-form-btn');

      if (urlParams.get('mode') === 'view' || urlParams.get('viewOnly') === 'true') {
        if (addReviewCard) addReviewCard.style.display = 'none';
        if (toggleAddFormBtn) toggleAddFormBtn.style.display = 'inline-flex';
      }

      window.toggleReviewForm = function() {
        if (!addReviewCard) return;
        if (addReviewCard.style.display === 'none' || addReviewCard.style.display === '') {
          addReviewCard.style.display = 'block';
          addReviewCard.scrollIntoView({ behavior: 'smooth' });
        } else {
          addReviewCard.style.display = 'none';
        }
      };

      // Interactive Star Rating Logic
      function updateStarPicker(score) {
        const val = Number(score) || 5;
        ratingInput.value = val;
        ratingText.textContent = ratingLabels[val] || `${val} Stars`;

        starPickerSpans.forEach(span => {
          const sVal = Number(span.getAttribute('data-star'));
          if (sVal <= val) {
            span.classList.add('active');
          } else {
            span.classList.remove('active');
          }
        });
      }

      starPickerSpans.forEach(span => {
        span.addEventListener('click', () => {
          const val = span.getAttribute('data-star');
          updateStarPicker(val);
        });

        span.addEventListener('mouseenter', () => {
          const val = Number(span.getAttribute('data-star'));
          starPickerSpans.forEach(s => {
            const sVal = Number(s.getAttribute('data-star'));
            if (sVal <= val) {
              s.style.color = '#f59e0b';
            } else {
              s.style.color = '#4b5563';
            }
          });
        });
      });

      document.getElementById('star-picker').addEventListener('mouseleave', () => {
        updateStarPicker(ratingInput.value);
      });

      // Default to 5 stars
      updateStarPicker(5);

      function renderStars(rating) {
        const num = Number(rating) || 0;
        let stars = '';
        for (let i = 1; i <= 5; i++) {
          stars += i <= num ? '★' : '☆';
        }
        return `<span class="stars-row" title="${num} out of 5 stars">${stars}</span>`;
      }

      function formatDate(d) {
        if (!d) return '';
        try {
          return new Date(d).toLocaleDateString('en-IN', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          });
        } catch (e) {
          return '';
        }
      }

      // Fetch reviews from backend API: GET /review/display/:ID
      async function loadReviews() {
        if (!serviceId) {
          reviewsList.innerHTML = `<div class="empty-reviews"><p>Invalid service ID.</p></div>`;
          return;
        }

        try {
          const res = await fetch('/review/display/' + encodeURIComponent(serviceId));
          const data = await res.json();
          const reviews = Array.isArray(data) ? data : ((data && Array.isArray(data.review)) ? data.review : []);

          reviewsCount.textContent = `${reviews.length} review${reviews.length === 1 ? '' : 's'}`;

          if (reviews.length === 0) {
            reviewsList.innerHTML = `
              <div class="empty-reviews">
                <i data-lucide="message-square"></i>
                <p>No reviews submitted yet. Be the first to leave a review!</p>
              </div>
            `;
            lucide.createIcons();
            return;
          }

          reviewsList.innerHTML = reviews.map(r => {
            const comment = r.coment || r.Coment || r.Comment || 'No comment provided.';
            const rating = r.rating || 5;
            const dateStr = formatDate(r.date);

            return `
              <div class="review-item">
                <div class="review-item-header">
                  ${renderStars(rating)}
                  ${dateStr ? `<span class="review-date">${dateStr}</span>` : ''}
                </div>
                <div class="review-text">${comment}</div>
              </div>
            `;
          }).join('');

          lucide.createIcons();
        } catch (err) {
          console.error("Failed to load reviews:", err);
          reviewsList.innerHTML = `
            <div class="empty-reviews">
              <p>Failed to load reviews. Please refresh.</p>
            </div>
          `;
        }
      }

      // Handle Review Submission
      if (reviewForm) {
        reviewForm.addEventListener('submit', async (e) => {
          e.preventDefault();

          const comentVal = document.getElementById('Coment').value;
          const ratingVal = ratingInput.value;

          try {
            const res = await fetch('/review/' + encodeURIComponent(serviceId), {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                Coment: comentVal,
                coment: comentVal,
                rating: Number(ratingVal)
              })
            });

            const result = await res.json();

            if (res.ok && (result.success !== false)) {
              successToast.style.display = 'flex';
              reviewForm.reset();
              updateStarPicker(5);
              loadReviews();
              setTimeout(() => {
                successToast.style.display = 'none';
              }, 4000);
            } else {
              alert(result.error || "Failed to submit review");
            }
          } catch (err) {
            console.error("Submission error:", err);
            alert("Error submitting review. Please try again.");
          }
        });
      }

      // Initial load
      loadReviews();
    });
  </script>
</body>
</html>

